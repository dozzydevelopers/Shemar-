# Client-side configuration
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only (Secrets - NEVER prefix with VITE_)
# GEMINI_API_KEY: Required for Gemini AI Web Research & Grounding API calls.
# Injected at runtime from user secrets in AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL of the application
APP_URL="MY_APP_URL"
